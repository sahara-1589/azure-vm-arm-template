{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "vmName": {
      "type": "string",
      "defaultValue": "myVM"
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    },
    "adminUsername": {
      "type": "string",
      "defaultValue": "azureuser"
    }
  },
  "variables": {},
  "resources": [],
  "outputs": {
    "vmName": {
      "type": "string",
      "value": "[parameters('vmName')]"
    }
  }
}
